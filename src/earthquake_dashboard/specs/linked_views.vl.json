{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"name": "eq"},
  "usermeta": {"embedOptions": {"loader": {"target": "_blank"}}},
  "config": {
    "background": "#0e0435ee",
    "view": {"stroke": "#888"},
    "title": {"color": "#fff", "subtitleColor": "#fff"},
    "style": {"guide-label": {"fill": "#fff"}, "guide-title": {"fill": "#fff"}},
    "axis": {"domainColor": "#fff", "gridColor": "#888", "tickColor": "#fff"},
    "padding": 10,
    "font": "monospace",
    "autosize": "pad",
    "projection": {"translate": [250, 250]}
  },
  "params": [
    {
      "name": "PROJECTION",
      "value": "gnomonic",
      "bind": {
        "input": "select",
        "name": "Projection",
        "options": [
          "albers",
          "albersUsa",
          "azimuthalEqualArea",
          "azimuthalEquidistant",
          "conicConformal",
          "conicEqualArea",
          "conicEquidistant",
          "equalEarth",
          "equirectangular",
          "gnomonic",
          "mercator",
          "naturalEarth1",
          "orthographic",
          "stereographic",
          "transverseMercator"
        ]
      }
    },
    {
      "name": "zoom",
      "value": 200,
      "bind": {"input": "range", "name": "Zoom", "min": 10, "max": 1000, "step": 1}
    },
    {
      "name": "rotate0",
      "value": 0,
      "bind": {"input": "range", "name": "Spin E–W", "min": -180, "max": 180, "step": 1}
    },
    {
      "name": "rotate1",
      "value": 0,
      "bind": {"input": "range", "name": "Tilt N–S", "min": -90, "max": 90, "step": 1}
    },
    {
      "name": "rotate2",
      "value": 0,
      "bind": {"input": "range", "name": "Roll", "min": -180, "max": 180, "step": 1}
    },
    {
      "name": "mag_bins",
      "value": 10,
      "bind": {"input": "range", "name": "Magnitude bins", "min": 1, "max": 20, "step": 1}
    },
    {"name": "magExtent", "expr": "extent(pluck(data('eq'), 'mag'))"},
    {"name": "timeRaw", "expr": "extent(pluck(data('eq'), 'time'))"},
    {
      "name": "timeExtent",
      "expr": "[utcOffset('date', timeRaw[0], -1), utcOffset('date', timeRaw[1], 1)]"
    },
    {
      "name": "VAR",
      "value": "mag"
    },
    {"name": "varExtent", "expr": "extent(pluck(data('eq'), VAR))"}
  ],
  "hconcat": [
    {
      "vconcat": [
        {
          "description": "Map View",
          "name": "map_view",
          "width": 500,
          "height": 400,
          "layer": [
            {
              "description": "blue_marble",
              "data": {"sphere": true},
              "projection": {
                "type": {"expr": "PROJECTION"},
                "rotate": {"expr": "[rotate0, rotate1, rotate2]"},
                "scale": {"expr": "zoom"}
              },
              "mark": {"type": "geoshape", "fill": "#00346b"}
            },
            {
              "description": "Geoshape",
              "data": {
                "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/world-110m.json",
                "format": {"type": "topojson", "feature": "countries"}
              },
              "projection": {
                "type": {"expr": "PROJECTION"},
                "rotate": {"expr": "[rotate0, rotate1, rotate2]"},
                "scale": {"expr": "zoom"}
              },
              "mark": {
                "type": "geoshape",
                "fill": "lightgray",
                "stroke": "gray",
                "opacity": 1
              }
            },
            {
              "description": "graticule",
              "data": {"graticule": {"step": [30, 30]}},
              "mark": {
                "type": "geoshape",
                "stroke": "black",
                "strokeWidth": 0.5
              },
              "projection": {
                "type": {"expr": "PROJECTION"},
                "rotate": {"expr": "[rotate0, rotate1, rotate2]"},
                "scale": {"expr": "zoom"}
              }
            },
            {
              "description": "Scatterplot",
              "data": {"name": "eq"},
              "transform": [
                {
                  "calculate": "asin(clamp(sin(datum.lat * PI / 180) * sin(-rotate1 * PI / 180) + cos(datum.lat * PI / 180) * cos(-rotate1 * PI / 180) * cos((datum.lon + rotate0) * PI / 180), -1, 1)) * 180 / PI",
                  "as": "transformed_lat"
                },
                {
                  "filter": "datum.transformed_lat >= (PROJECTION === 'orthographic' ? 0 : (PROJECTION === 'gnomonic' ? 30 : (PROJECTION === 'stereographic' ? -52 : -90)))"
                },
                {
                  "calculate": "utcFormat(toDate(datum.time), '%Y-%m-%d %H:%M:%S') + ' UTC'",
                  "as": "_utc_time"
                }
              ],
              "params": [{"name": "BRUSH_MAP", "select": {"type": "interval"}}],
              "projection": {
                "type": {"expr": "PROJECTION"},
                "rotate": {"expr": "[rotate0, rotate1, rotate2]"},
                "scale": {"expr": "zoom"}
              },
              "mark": {"type": "circle", "cursor": "pointer"},
              "encoding": {
                "latitude": {"field": "lat", "type": "quantitative"},
                "longitude": {"field": "lon", "type": "quantitative"},
                "size": {"field": "mag", "type": "quantitative"},
                "color": {
                  "condition": {
                    "test": {
                      "and": [
                        {"param": "BRUSH_MAP"},
                        {"param": "BRUSH_MAG"},
                        {"param": "BRUSH_TIME"}
                      ]
                    },
                    "field": "sig",
                    "type": "quantitative",
                    "scale": {"scheme": {"name": "magma", "extent": [0.2, 1]}}
                  },
                  "value": "grey"
                },
                "href": {"field": "url", "type": "nominal"},
                "tooltip": [
                  {"field": "place", "type": "nominal", "title": "Location"},
                  {"field": "_utc_time", "type": "nominal", "title": "Time (UTC)"},
                  {"field": "mag", "type": "quantitative", "title": "Magnitude"},
                  {"field": "depth", "type": "quantitative", "title": "Depth (km)"},
                  {"field": "sig", "type": "quantitative", "title": "Significance"},
                  {"field": "lat", "type": "quantitative", "title": "Latitude", "format": ".4f"},
                  {"field": "lon", "type": "quantitative", "title": "Longitude", "format": ".4f"},
                  {"field": "url", "type": "nominal", "title": "USGS"}
                ]
              }
            }
          ]
        },
        {
          "description": "Histograms",
          "vconcat": [
            {
              "description": "Time View",
              "height": 50,
              "width": 500,
              "layer": [
                {
                  "description": "Time Hist Invisible",
                  "data": {"name": "eq"},
                  "params": [
                    {
                      "name": "BRUSH_TIME",
                      "select": {
                        "type": "interval",
                        "encodings": ["x"],
                        "fields": ["time"]
                      }
                    }
                  ],
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "time",
                      "type": "temporal",
                      "title": "date (UTC)",
                      "scale": {"type": "utc", "domain": {"expr": "timeExtent"}}
                    },
                    "y": {"field": "*", "aggregate": "count", "title": "count"},
                    "color": {"value": "grey"},
                    "fillOpacity": {"value": 0}
                  }
                },
                {
                  "description": "Time Hist Static",
                  "data": {"name": "eq"},
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "time",
                      "type": "temporal",
                      "timeUnit": {"unit": "utcyearmonthdate"},
                      "scale": {"type": "utc", "domain": {"expr": "timeExtent"}}
                    },
                    "y": {"field": "*", "aggregate": "count"},
                    "color": {"value": "grey"}
                  }
                },
                {
                  "description": "Time Hist Filtered",
                  "data": {"name": "eq"},
                  "transform": [
                    {
                      "calculate": "asin(clamp(sin(datum.lat * PI / 180) * sin(-rotate1 * PI / 180) + cos(datum.lat * PI / 180) * cos(-rotate1 * PI / 180) * cos((datum.lon + rotate0) * PI / 180), -1, 1)) * 180 / PI",
                      "as": "transformed_lat"
                    },
                    {
                      "filter": "datum.transformed_lat >= (PROJECTION === 'orthographic' ? 0 : (PROJECTION === 'gnomonic' ? 30 : (PROJECTION === 'stereographic' ? -52 : -90)))"
                    },
                    {"filter": {"param": "BRUSH_TIME"}},
                    {"filter": {"param": "BRUSH_MAP"}},
                    {"filter": {"param": "BRUSH_MAG"}}
                  ],
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "time",
                      "type": "temporal",
                      "timeUnit": {"unit": "utcyearmonthdate"},
                      "scale": {"type": "utc", "domain": {"expr": "timeExtent"}}
                    },
                    "y": {"field": "*", "aggregate": "count"},
                    "color": {"field": "sig", "type": "quantitative", "scale": {"scheme": {"name": "magma", "extent": [0.2, 1]}}}
                  }
                }
              ]
            },
            {
              "description": "Mag View",
              "height": 50,
              "width": 500,
              "layer": [
                {
                  "description": "Mag Hist Invisible",
                  "data": {"name": "eq"},
                  "params": [
                    {
                      "name": "BRUSH_MAG",
                      "select": {
                        "type": "interval",
                        "encodings": ["x"],
                        "fields": ["mag"]
                      }
                    }
                  ],
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "mag",
                      "type": "quantitative",
                      "title": "mag (binned)",
                      "scale": {"domain": {"expr": "magExtent"}}
                    },
                    "y": {
                      "field": "*",
                      "type": "quantitative",
                      "aggregate": "count",
                      "title": "count"
                    },
                    "color": {"value": "grey"},
                    "opacity": {"value": 0}
                  }
                },
                {
                  "description": "Mag Hist Static",
                  "data": {"name": "eq"},
                  "transform": [
                    {"filter": "isValid(datum.mag)"},
                    {
                      "calculate": "(magExtent[1] - magExtent[0]) / mag_bins",
                      "as": "mag_step"
                    },
                    {
                      "calculate": "magExtent[0] + min(floor((datum.mag - magExtent[0]) / datum.mag_step), mag_bins - 1) * datum.mag_step",
                      "as": "mag_bin_start"
                    },
                    {
                      "calculate": "datum.mag_bin_start + datum.mag_step",
                      "as": "mag_bin_end"
                    }
                  ],
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "mag_bin_start",
                      "bin": {"binned": true},
                      "title": "mag (binned)",
                      "scale": {"domain": {"expr": "magExtent"}}
                    },
                    "x2": {"field": "mag_bin_end"},
                    "y": {"aggregate": "count", "title": "count"},
                    "color": {"value": "grey"},
                    "opacity": {"value": 1}
                  }
                },
                {
                  "description": "Mag Hist Filtered",
                  "data": {"name": "eq"},
                  "transform": [
                    {"filter": "isValid(datum.mag)"},
                    {
                      "calculate": "(magExtent[1] - magExtent[0]) / mag_bins",
                      "as": "mag_step"
                    },
                    {
                      "calculate": "magExtent[0] + min(floor((datum.mag - magExtent[0]) / datum.mag_step), mag_bins - 1) * datum.mag_step",
                      "as": "mag_bin_start"
                    },
                    {
                      "calculate": "datum.mag_bin_start + datum.mag_step",
                      "as": "mag_bin_end"
                    },
                    {
                      "calculate": "asin(clamp(sin(datum.lat * PI / 180) * sin(-rotate1 * PI / 180) + cos(datum.lat * PI / 180) * cos(-rotate1 * PI / 180) * cos((datum.lon + rotate0) * PI / 180), -1, 1)) * 180 / PI",
                      "as": "transformed_lat"
                    },
                    {
                      "filter": "datum.transformed_lat >= (PROJECTION === 'orthographic' ? 0 : (PROJECTION === 'gnomonic' ? 30 : (PROJECTION === 'stereographic' ? -52 : -90)))"
                    },
                    {"filter": {"param": "BRUSH_TIME"}},
                    {"filter": {"param": "BRUSH_MAP"}},
                    {"filter": {"param": "BRUSH_MAG"}}
                  ],
                  "mark": "bar",
                  "encoding": {
                    "x": {
                      "field": "mag_bin_start",
                      "bin": {"binned": true},
                      "title": "mag (binned)",
                      "scale": {"domain": {"expr": "magExtent"}}
                    },
                    "x2": {"field": "mag_bin_end"},
                    "y": {"aggregate": "count", "title": "count"},
                    "color": {"field": "sig", "type": "quantitative", "scale": {"scheme": {"name": "magma", "extent": [0.2, 1]}}}
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Heatmap",
      "layer": [
        {
          "description": "heatmap static",
          "data": {"name": "eq"},
          "height": 600,
          "mark": "rect",
          "encoding": {
            "x": {
              "field": "time",
              "type": "temporal",
              "timeUnit": {"unit": "utcyearmonthdate", "step": 1}
            },
            "y": {
              "field": "depth",
              "type": "quantitative",
              "bin": {"maxbins": 10}
            },
            "color": {"value": "grey"},
            "opacity": {
              "field": "*",
              "type": "quantitative",
              "aggregate": "count"
            }
          }
        },
        {
          "description": "heatmap filtered",
          "data": {"name": "eq"},
          "transform": [
            {
              "calculate": "asin(clamp(sin(datum.lat * PI / 180) * sin(-rotate1 * PI / 180) + cos(datum.lat * PI / 180) * cos(-rotate1 * PI / 180) * cos((datum.lon + rotate0) * PI / 180), -1, 1)) * 180 / PI",
              "as": "transformed_lat"
            },
            {
              "filter": "datum.transformed_lat >= (PROJECTION === 'orthographic' ? 0 : (PROJECTION === 'gnomonic' ? 30 : (PROJECTION === 'stereographic' ? -52 : -90)))"
            },
            {"filter": {"param": "BRUSH_TIME"}},
            {"filter": {"param": "BRUSH_MAP"}},
            {"filter": {"param": "BRUSH_MAG"}}
          ],
          "mark": {"type": "rect"},
          "encoding": {
            "x": {
              "field": "time",
              "type": "temporal",
              "timeUnit": {"unit": "utcyearmonthdate", "step": 1}
            },
            "y": {
              "field": "depth",
              "type": "quantitative",
              "bin": {"maxbins": 10}
            },
            "color": {
              "field": "sig",
              "type": "quantitative",
              "aggregate": "mean",
              "scale": {"scheme": {"name": "magma", "extent": [0.2, 1]}}
            },
            "opacity": {
              "field": "*",
              "type": "quantitative",
              "aggregate": "count"
            }
          }
        }
      ]
    }
  ]
}
